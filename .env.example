# ==============================================================================
# SMART CUSTOMER FEEDBACK ANALYZER - ROOT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env or configure respective container environment variables.

# Project Metadata
PROJECT_NAME="Smart Customer Feedback Analyzer"
PROJECT_VERSION="1.0.0"
ENVIRONMENT="development"  # Options: development, staging, production

# ------------------------------------------------------------------------------
# Django Core API Gateway (Port 8000)
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY="dev-insecure-secret-key-change-in-production-only"
DJANGO_DEBUG=True  # Set to False in production
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0,django-api,testserver"
DJANGO_CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
DJANGO_CSRF_TRUSTED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Configuration (Defaults to SQLite; auto-switches to PostgreSQL if DB_ENGINE or POSTGRES_DB is provided)
DB_ENGINE="sqlite3"  # Set to 'postgresql' for production
DB_NAME="feedback_db"
DB_USER="postgres"
DB_PASSWORD="ChangeThisInProductionSecurely123!"
DB_HOST="localhost"
DB_PORT=5432
DB_CONN_MAX_AGE=600

# Production Security & SSL Headers (Step 8)
DJANGO_SECURE_SSL_REDIRECT=False  # Set to True in production with HTTPS
DJANGO_SESSION_COOKIE_SECURE=False  # Set to True in production with HTTPS
DJANGO_CSRF_COOKIE_SECURE=False  # Set to True in production with HTTPS
DJANGO_SECURE_HSTS_SECONDS=31536000

# Rate Limiting & Throttling
THROTTLE_RATE_ANON="200/minute"
THROTTLE_RATE_USER="1000/minute"
THROTTLE_RATE_AUTH="30/minute"
THROTTLE_RATE_IMPORTS="60/minute"
THROTTLE_RATE_EXPORTS="60/minute"

# Internal downstream ML service endpoint
ML_SERVICE_URL="http://localhost:8001"
ML_SERVICE_ENABLED=True
ML_SERVICE_TIMEOUT_SECONDS=30.0
MAX_FEEDBACK_ANALYSIS_BATCH_SIZE=50

# Bulk Ingestion & Export Configuration (Step 7)
IMPORT_CHUNK_SIZE=500
MAX_IMPORT_FILE_SIZE_MB=10
MAX_IMPORT_ROWS=10000
EXPORT_MAX_ROWS=50000
IMPORT_ERROR_LIMIT=100

# ------------------------------------------------------------------------------
# FastAPI ML & NLP Service (Port 8001)
# ------------------------------------------------------------------------------
FASTAPI_ENVIRONMENT="development"
FASTAPI_LOG_LEVEL="INFO"
FASTAPI_PORT=8001
FASTAPI_HOST="0.0.0.0"
FASTAPI_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"
FASTAPI_MODEL_PATH="./models_cache"
FASTAPI_BATCH_SIZE=32
FASTAPI_DEVICE="cpu"  # Options: auto, cpu, cuda

# ------------------------------------------------------------------------------
# Next.js Frontend Dashboard (Port 3000)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Smart Customer Feedback Analyzer"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
